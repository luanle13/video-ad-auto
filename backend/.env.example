# AI Video Platform - Backend Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# Application Settings
# ============================================
ENVIRONMENT=dev
DEBUG=true

# ============================================
# AWS Configuration
# ============================================
AWS_REGION=ap-southeast-1
# AWS_ACCESS_KEY_ID=  # Optional: Uses default AWS credential chain if not set
# AWS_SECRET_ACCESS_KEY=  # Optional: Uses default AWS credential chain if not set

# ============================================
# AWS Cognito Configuration
# ============================================
# Get these values from AWS Console or Terraform output:
#   terraform output cognito_user_pool_id
#   terraform output cognito_app_client_id

COGNITO_USER_POOL_ID=your-user-pool-id
COGNITO_CLIENT_ID=your-client-id
COGNITO_REGION=ap-southeast-1

# ============================================
# DynamoDB Tables
# ============================================
DYNAMODB_USERS_TABLE=ai-video-users
DYNAMODB_PRODUCTS_TABLE=ai-video-products
DYNAMODB_JOBS_TABLE=ai-video-jobs

# ============================================
# S3 Buckets
# ============================================
# Get these values from Terraform output:
#   terraform output s3_images_bucket
#   terraform output s3_videos_bucket

S3_IMAGES_BUCKET=your-images-bucket
S3_VIDEOS_BUCKET=your-videos-bucket

# ============================================
# Frontend URL (for CORS)
# ============================================
FRONTEND_URL=http://localhost:5173

# ============================================
# Step Functions
# ============================================
# Get this value from Terraform output:
#   terraform output state_machine_arn

STEPFUNCTIONS_STATE_MACHINE_ARN=your-state-machine-arn

# ============================================
# Secrets Manager Keys
# ============================================
# These reference secrets stored in AWS Secrets Manager
SECRETS_OPENAI_KEY=ai-video-dev/openai-api-key
SECRETS_ELEVENLABS_KEY=ai-video-dev/elevenlabs-api-key
SECRETS_DEEPINFRA_KEY=ai-video-dev/deepinfra-api-key

# ============================================
# Direct API Keys (for local development only)
# ============================================
# Use these instead of Secrets Manager for local development
# WARNING: Never commit actual API keys to version control!

# OPENAI_API_KEY=sk-your-openai-api-key
# ELEVENLABS_API_KEY=your-elevenlabs-api-key
# DEEPINFRA_API_KEY=your-deepinfra-api-key

# ============================================
# Azure OpenAI (Optional - for image generation)
# ============================================
# AZURE_OPENAI_API_KEY=your-azure-api-key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/openai/v1/
