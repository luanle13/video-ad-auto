# AI Video Automation System - Environment Variables

# Application Settings
ENVIRONMENT=development
DEBUG=true

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=fake_access_key
AWS_SECRET_ACCESS_KEY=fake_secret_key

# LocalStack Configuration (for local development)
AWS_ENDPOINT_URL=http://localhost:4566

# DynamoDB
DYNAMODB_TABLE_PREFIX=ai-video-platform

# Redis Cache
REDIS_URL=redis://localhost:6379/0

# Secrets Manager Keys (ARN or name)
SECRETS_OPENAI_KEY=ai-video/openai-api-key
SECRETS_KLING_KEY=ai-video/kling-api-key
SECRETS_ELEVENLABS_KEY=ai-video/elevenlabs-api-key

# OpenAI Configuration
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.7

# API Keys (for local development only - use Secrets Manager in production)
OPENAI_API_KEY=your_openai_api_key_here
KLING_API_KEY=your_kling_ai_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Database (if using PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/ai_video_dev

# Auth Settings
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Step Functions ARN (for local development, you might use a mock)
STEP_FUNCTIONS_ARN=arn:aws:states:us-east-1:123456789012:stateMachine:video-generation

# CORS Settings
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Logging
LOG_LEVEL=INFO