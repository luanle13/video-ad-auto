# AI Video Platform - Frontend Environment Variables
# Copy this file to .env.local and fill in your values

# ============================================
# API Configuration
# ============================================
# For local development, use the local backend URL
VITE_API_URL=http://localhost:8000

# For production, use the deployed API Gateway URL
# VITE_API_URL=https://your-api-gateway-url.execute-api.ap-southeast-1.amazonaws.com

# ============================================
# AWS Cognito Configuration
# ============================================
# Get these values from AWS Console or Terraform output:
#   terraform output cognito_user_pool_id
#   terraform output cognito_app_client_id

VITE_COGNITO_USER_POOL_ID=your-user-pool-id
VITE_COGNITO_CLIENT_ID=your-client-id
VITE_COGNITO_REGION=ap-southeast-1
